# Build the reviewed fork from source; no upstream application image.
FROM node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS backend
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/*
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY app/ ./app/
COPY smoke_test/ ./smoke_test/
COPY scripts/ ./scripts/
COPY README.md ./
COPY static/ ./static/
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist
RUN mkdir -p /app/logs && chown 999:994 /app/logs
ENV QUICKLY_MODE=production QUICKLY_PREBUILT_IMAGE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
USER 999:994
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Exercise the saved-content API against an isolated SQLite database at build time.
FROM backend AS test
USER root
RUN pip install --no-cache-dir pytest==9.1.1 pytest-asyncio==1.3.0
COPY tests/ ./tests/
COPY pytest.ini ./
ENV TEST_DATABASE_URL=sqlite+aiosqlite:///:memory: TEST_MODE=true
RUN python -m pytest tests/test_personalized_editor.py tests/test_custom_sequence_mode_e2e.py tests/test_gmail_oauth.py tests/test_strive_jwt.py tests/test_email_content_preview.py tests/test_schedule_body_resolution.py -q && touch /tmp/tests-passed

FROM backend AS runtime
COPY --from=test /tmp/tests-passed /app/tests-passed
